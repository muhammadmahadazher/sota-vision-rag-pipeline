# Reliable local mode; no model download required.
VISION_MODE=lite
VISION_MODEL=yolov8s-worldv2.pt

# Optional services. The API degrades gracefully when these are blank/unavailable.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RAG_STRICT=false

# Optional WebSocket authentication. Leave blank for loopback-only development.
API_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

SYNTHESIS_INTERVAL_SECONDS=4
MAX_PAYLOAD_BYTES=5242880
